<Window x:Class="ComCon.UI.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose row highlight color"
        Width="500" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Preset palette swatches (click to select):" FontWeight="SemiBold" Margin="0,0,0,8" />

        <WrapPanel x:Name="SwatchesPanel" Grid.Row="1" Margin="0,0,0,14" />

        <TextBlock Grid.Row="2" Text="Fine-tune color (RGB sliders or Hex code):" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Red:" VerticalAlignment="Center" />
            <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    ValueChanged="SliderValueChanged" Margin="8,4" VerticalAlignment="Center" />
            <TextBlock x:Name="RedValueText" Grid.Row="0" Grid.Column="2" Text="200" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Green:" VerticalAlignment="Center" />
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    ValueChanged="SliderValueChanged" Margin="8,4" VerticalAlignment="Center" />
            <TextBlock x:Name="GreenValueText" Grid.Row="1" Grid.Column="2" Text="230" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Blue:" VerticalAlignment="Center" />
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    ValueChanged="SliderValueChanged" Margin="8,4" VerticalAlignment="Center" />
            <TextBlock x:Name="BlueValueText" Grid.Row="2" Grid.Column="2" Text="201" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Hex:" VerticalAlignment="Center" Margin="0,6,0,0" />
            <TextBox x:Name="HexTextBox" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                     Margin="8,6,0,0" TextChanged="HexTextBoxChanged" />
        </Grid>

        <Border Grid.Row="4" x:Name="PreviewBorder" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4"
                Padding="12,8" Margin="0,4,0,16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PreviewLabel" Text="Table row preview: " FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="PreviewText" Text="Profile 1 / Running (Sample profile text)" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="OkClick" IsDefault="True" Width="80" Padding="8,4" Margin="0,0,10,0" />
            <Button Content="Cancel" Click="CancelClick" IsCancel="True" Width="80" Padding="8,4" />
        </StackPanel>
    </Grid>
</Window>
