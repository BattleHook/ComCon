<Window x:Class="ComCon.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ComCon" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="14" Icon="pack://application:,,,/Assets/ComConApp.ico">
    <StackPanel Margin="20">
        <TextBlock Text="Welcome to ComCon" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="ComCon shares your radio's COM port between station programs. The Help guide explains installation, virtual COM ports, profiles and troubleshooting. Press F1 or use the Help button at any time." />
        <TextBlock x:Name="SafetyText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="DonationText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#555555"
                   Text="This welcome is shown once. Help and About stay available from the main window." />
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Open Help" Click="OpenHelp" Padding="10,4" />
            <Button DockPanel.Dock="Left" Content="Support on Ko-fi (optional)" Click="OpenKoFi" Padding="10,4" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Continue" IsDefault="True" IsCancel="True" Padding="16,4" />
        </DockPanel>
    </StackPanel>
</Window>
