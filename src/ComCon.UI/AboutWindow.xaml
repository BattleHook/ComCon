<Window x:Class="ComCon.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ComCon" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="14" Icon="pack://application:,,,/Assets/ComConApp.ico">
    <StackPanel Margin="20">
        <TextBlock Text="ComCon" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,0" />
        <TextBlock x:Name="AttributionText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="LicenseText" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="SafetyText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Text="ComCon is free to use. Support is provided through GitHub Issues, without a guaranteed response time."
                   Margin="0,12,0,0" TextWrapping="Wrap" />
        <WrapPanel Margin="0,16,0,0">
            <Button Content="License" Click="OpenLicense" Padding="10,4" Margin="0,0,8,8" />
            <Button Content="Third-party notices" Click="OpenNotices" Padding="10,4" Margin="0,0,8,8" />
            <Button Content="Help guide" Click="OpenHelp" Padding="10,4" Margin="0,0,8,8" />
            <Button Content="Repository" Click="OpenRepository" Padding="10,4" Margin="0,0,8,8" />
            <Button Content="Report an issue" Click="OpenIssues" Padding="10,4" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock x:Name="DonationText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Support on Ko-fi (optional)" Click="OpenKoFi" Padding="10,4" />
            <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" IsCancel="True" Padding="16,4" />
        </DockPanel>
    </StackPanel>
</Window>
