<Window x:Class="ComCon.UI.BridgeStartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start additional bridges" Width="1250" Height="480"
        MinWidth="800" MinHeight="350" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Choose profiles to start. Existing bridges and client sessions remain untouched."
                       TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="Rows show saved ports while stopped and active ports while running. IPC details are configuration, not connection status."
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="RawWarning" TextWrapping="Wrap" Margin="0,10"
                       Text="RAW WARNING: selected RAW bridges forward bytes unchanged, including transmit/tune commands. Start selected confirms this warning." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartSelectedButton" Content="Start selected" Click="StartSelected"
                        IsDefault="True" Padding="12,6" />
                <Button Content="Cancel - leave running bridges unchanged" IsCancel="True"
                        Margin="12,0,0,0" Padding="12,6" />
            </StackPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource RunningRowForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FaultRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FaultRowForegroundBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource RunningSelectedRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource RunningRowForegroundBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFaulted}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource FaultSelectedRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FaultRowForegroundBrush}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Start" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanStart}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Profile / Transceiver" Binding="{Binding Profile}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="Saved mode" Binding="{Binding SavedMode}" IsReadOnly="True" Width="85" />
                <DataGridTextColumn Header="Actual state" Binding="{Binding ActualState}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="Legacy Client COM" Binding="{Binding LegacyClientCom}" IsReadOnly="True" Width="125" />
                <DataGridTextColumn Header="ComCon virtual COM" Binding="{Binding ComConVirtualCom}" IsReadOnly="True" Width="135" />
                <DataGridTextColumn Header="Transceiver COM" Binding="{Binding TransceiverCom}" IsReadOnly="True" Width="120" />
                <DataGridTextColumn Header="IPC Client / pipe" Binding="{Binding IpcDetails}" IsReadOnly="True" Width="220" />
                <DataGridTextColumn Header="Status / reason" Binding="{Binding Reason}" IsReadOnly="True" Width="330" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
