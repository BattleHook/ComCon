{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build ComCon Release",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				".\\ComConApp.sln",
				"--configuration",
				"Release",
				"--no-restore",
				"--verbosity",
				"normal"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}